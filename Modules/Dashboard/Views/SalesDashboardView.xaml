<UserControl x:Class="Northwind.Views.SalesDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Northwind.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Views"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             d:DesignHeight="450"
             d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="{StaticResource LightGrayColorBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <WrapPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <controls:RegionSelector Margin="0,0,10,0"
                                         Region="{Binding Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                         Regions="{Binding Path=Regions, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                <controls:TerritorySelector Margin="0,0,10,0"
                                            Territories="{Binding Path=Territories, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                            Territory="{Binding Territory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                <!--<controls:DateSelector Margin="0,0,10,0"
                                       Month="{Binding Month, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                       Months="{Binding Months, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                       Quarter="{Binding Quarter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                       Quarters="{Binding Quarters, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                       Year="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                       Years="{Binding Years, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />-->
                <controls:CategorySelector Margin="0,0,10,0"
                                           Categories="{Binding Path=Categories, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                           Category="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                <controls:ProductSelector Margin="0,0,10,0"
                                          Product="{Binding Product, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                          Products="{Binding Path=Products, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                <controls:EmployeeSelector Margin="0,0,10,0"
                                           Employee="{Binding Employee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                           Employees="{Binding Path=Employees, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                <controls:CustomerSelector Margin="0,0,10,0"
                                           Customer="{Binding Customer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                           Customers="{Binding Path=Customers, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                <controls:SupplierSelector Margin="0,0,10,0"
                                           Supplier="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                           Suppliers="{Binding Path=Suppliers, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                <controls:ShipperSelector Shipper="{Binding Shipper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" Shippers="{Binding Path=Shippers, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
            </WrapPanel>
        </Border>
        <StackPanel Grid.Row="1" />
        <StackPanel Grid.Row="2" />
    </Grid>
</UserControl>
