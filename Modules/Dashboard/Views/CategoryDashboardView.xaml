<UserControl x:Class="Northwind.Views.CategoryDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:nw="urn:northwind:controls"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Northwind.ViewModels"
             xmlns:widgets="clr-namespace:Northwind.Widgets"
             d:DataContext="{d:DesignInstance Type=viewmodels:CategoryDashboardViewModel}"
             d:DesignHeight="1024"
             d:DesignWidth="1280"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <prism:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ShowGridLines="{Binding Path=IsInDebugMode}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  FILTER  -->
        <Border Margin="0,10,0,0"
                Padding="10,20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="White"
                BorderBrush="{StaticResource LightGrayColorBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5"
                                  Opacity=".125"
                                  ShadowDepth="1" />
            </Border.Effect>

            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ShowGridLines="{Binding Path=IsInDebugMode}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              Width="32"
                              Height="32"
                              Margin="0,0,10,0"
                              HorizontalAlignment="Left"
                              IsChecked="{Binding Path=IsInDebugMode, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}">
                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type ToggleButton}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <md:PackIcon Width="22"
                                                 Height="22"
                                                 Kind="Bug" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <md:PackIcon Width="22"
                                                         Height="22"
                                                         Foreground="{StaticResource MediumRedColorBrush}"
                                                         Kind="Bug" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <!--  DATE SELECTOR  -->
                <Grid Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ShowGridLines="{Binding Path=IsInDebugMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryColorBrush}"
                               Text="Date Selection" />
                    <Grid Grid.Row="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ShowGridLines="{Binding Path=IsInDebugMode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ShowGridLines="{Binding Path=IsInDebugMode}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       MinWidth="80"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryColorBrush}"
                                       Text="{Binding StartDate, StringFormat=d, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                       TextAlignment="Left" />
                            <TextBlock Grid.Column="1"
                                       MinWidth="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryColorBrush}"
                                       Text="-"
                                       TextAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       MinWidth="80"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryColorBrush}"
                                       Text="{Binding EndDate, StringFormat=d, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                       TextAlignment="Right" />
                        </Grid>

                        <ToggleButton x:Name="ShowCalendarButton"
                                      Grid.Column="2"
                                      Margin="10,0,10,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Background="{x:Null}"
                                      BorderBrush="{x:Null}"
                                      Foreground="{StaticResource PrimaryColorBrush}"
                                      Style="{x:Null}">
                            <md:PackIcon Kind="ArrowDownDropCircle">
                                <md:PackIcon.Style>
                                    <Style TargetType="md:PackIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToggleButton}, Path=IsChecked}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryColorBrush}" />
                                                <Setter Property="Kind" Value="ArrowUpDropCircle" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:PackIcon.Style>
                            </md:PackIcon>
                        </ToggleButton>

                        <Popup IsOpen="{Binding ElementName=ShowCalendarButton, Path=IsChecked}"
                               Placement="Left"
                               PlacementRectangle="20,29,0,0"
                               PlacementTarget="{Binding ElementName=ShowCalendarButton}"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border Margin="0,0,0,0"
                                    Background="White"
                                    BorderBrush="WhiteSmoke"
                                    BorderThickness="0">
                                <Border Margin="10"
                                        Padding="16"
                                        Background="White"
                                        BorderBrush="WhiteSmoke"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="80"
                                                          Opacity=".125"
                                                          ShadowDepth="0" />
                                    </Border.Effect>
                                    <nw:DateRangeSlider EndDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                                        MaximumDate="{Binding MaximumDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                                        MinimumDate="{Binding MinimumDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                                        StartDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                </Border>
                            </Border>
                        </Popup>

                    </Grid>
                </Grid>

                <!--  LOAD COMMAND  -->
                <Button Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                    <md:PackIcon Kind="Refresh" />
                </Button>

            </Grid>
        </Border>

        <!--  CHARTS  -->
        <Grid Grid.Row="2"
              Margin="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ShowGridLines="{Binding Path=IsInDebugMode}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ShowGridLines="{Binding Path=IsInDebugMode}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="340" />
                    <!--<RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="10" />-->
                </Grid.RowDefinitions>
                <Border Grid.ColumnSpan="9"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{StaticResource LightGrayColorBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5"
                                          Opacity=".125"
                                          ShadowDepth="1" />
                    </Border.Effect>
                    <widgets:SalesByCategoryPieChartWidget DataContext="{Binding Path=SalesByCategory}" />
                </Border>

                <!--<Border Grid.Column="5"
                        Margin="0,0,10,0"
                        Padding="10"
                        Background="White"
                        BorderBrush="{StaticResource LightGrayColorBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5"
                                          Opacity=".125"
                                          ShadowDepth="1" />
                    </Border.Effect>

                </Border>
                <Border Grid.Column="6"
                        Margin="0,0,10,0"
                        Padding="10"
                        Background="White"
                        BorderBrush="{StaticResource LightGrayColorBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5"
                                          Opacity=".125"
                                          ShadowDepth="1" />
                    </Border.Effect>

                </Border>-->

            </Grid>
        </Grid>

    </Grid>
</UserControl>
