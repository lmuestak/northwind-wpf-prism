<UserControl x:Class="Northwind.Controls.SimpleInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="this"
             mc:Ignorable="d">
    <Grid HorizontalAlignment="{Binding ElementName=this, Path=HorizontalAlignment}" VerticalAlignment="{Binding ElementName=this, Path=VerticalAlignment}">
        <Rectangle Margin="20"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Fill="{Binding ElementName=this, Path=Background}"
                   RadiusX="10"
                   RadiusY="10">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="20"
                                  RenderingBias="Quality"
                                  ShadowDepth="1"
                                  Color="#FFDEDEDE" />
            </Rectangle.Effect>
        </Rectangle>
        <Grid Margin="25"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="35"
                  Height="70"
                  Margin="20,-5,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="{Binding ElementName=this, Path=IconBackground}">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      RenderingBias="Quality"
                                      ShadowDepth="1"
                                      Color="#FFECECEC" />
                </Grid.Effect>
                <md:PackIcon Width="24"
                             Height="24"
                             Margin="5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Foreground="{Binding ElementName=this, Path=IconForeground}"
                             Kind="{Binding ElementName=this, Path=Icon}" />
            </Grid>
            <TextBlock Grid.Column="1"
                       Margin="5"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Foreground="Gray"
                       Text="{Binding ElementName=this, Path=Title}" />
            <StackPanel Grid.Column="1"
                        Margin="10,20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontSize="50"
                           Foreground="Gray"
                           Text="{Binding ElementName=this, Path=InfoText}" />
                <TextBlock Margin="0,5"
                           VerticalAlignment="Bottom"
                           FontSize="20"
                           Foreground="Gray"
                           Text="{Binding ElementName=this, Path=SubInfoText}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="20"
                        VerticalAlignment="Bottom"
                        Cursor="Hand"
                        Orientation="Horizontal">
                <md:PackIcon Width="16"
                             Height="16"
                             Margin="5,0"
                             VerticalAlignment="Center"
                             Foreground="{Binding ElementName=this, Path=SubIconForeground}"
                             Kind="{Binding ElementName=this, Path=SubIcon}" />
                <TextBlock FontSize="8" Text="{Binding ElementName=this, Path=SubTitle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
