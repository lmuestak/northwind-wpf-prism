<UserControl x:Class="Northwind.Modules.Controls.CartesianTooltipControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Modules.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Northwind.Modules.ViewModels"
             xmlns:wpf="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{StaticResource MaterialDesignPaper}"
             mc:Ignorable="d">
    <ItemsControl Grid.IsSharedSizeScope="True" ItemsSource="{Binding Data.Points}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type wpf:DataPointViewModel}">
                <Grid Margin="2" Background="{Binding Series.Fill}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0"
                               Width="15"
                               Height="15"
                               Fill="{Binding Series.Fill}"
                               Stroke="{Binding Series.Stroke}" />
                    <TextBlock Grid.Column="1"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Series.Title}" />
                    <TextBlock Grid.Column="2"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ChartPoint.Y, StringFormat=C2}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
