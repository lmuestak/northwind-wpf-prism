<UserControl x:Class="Northwind.Controls.EmployeeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="260"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryColorBrush}"
                   Text="Employee" />
        <ComboBox Grid.Row="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  md:ComboBoxAssist.ShowSelectedItem="True"
                  md:HintAssist.Hint="Select an employee"
                  md:HintAssist.HintOpacity=".26"
                  ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmployeeSelector}}, Path=Employees}"
                  SelectedValue="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmployeeSelector}}, Path=Employee}"
                  Style="{StaticResource MaterialDesignComboBox}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#F5F5F5"
                                BorderThickness="4"
                                CornerRadius="90">
                            <Rectangle Width="24"
                                       Height="24"
                                       RadiusX="90"
                                       RadiusY="90">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Path=LastName, Converter={StaticResource NameToImageConverter}}" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Border>
                        <Grid Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource PrimaryColorBrush}" Text="{Binding EmployeeId}" />
                            <TextBlock Grid.Column="2"
                                       Foreground="{StaticResource PrimaryColorBrush}"
                                       Text="{Binding FullName}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       FontSize="10"
                                       Foreground="{StaticResource DarkGrayColorBrush}"
                                       Text="{Binding TitleOfCourtesyAndPosition}" />
                        </Grid>
                    </Grid>
                </DataTemplate>

            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
