<UserControl x:Class="Northwind.Views.CategoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             d:DesignHeight="600"
             d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="OperationCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Width="24"
                        Height="24"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=local:CategoryListView}, Path=DataContext.EditCategoryCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Edit category"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="0">
                    <md:PackIcon Height="16" Kind="Edit" />
                </Button>
                <Button Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=local:CategoryListView}, Path=DataContext.DeleteCategoryCommand}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Delete category"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="0">
                    <md:PackIcon Height="16"
                                 Background="Transparent"
                                 Foreground="{StaticResource MediumRedColorBrush}"
                                 Kind="Delete" />
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!--<Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Visibility="{Binding Path=IsLoading, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisiblityConverterInverted}}">-->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    BorderBrush="{StaticResource LightGrayColorBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                    <Border Background="{StaticResource LightGrayColorBrush}" CornerRadius="3,3,0,0">
                        <Grid Margin="0,5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0"
                                       Margin="15,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Text="Product categories"
                                       TextAlignment="Left" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Vertical"
                                Visibility="{Binding Path=IsLoading, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisiblityConverterInverted}}">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="1"
                                     Width="320"
                                     md:HintAssist.Hint="Enter keyword for search..."
                                     md:HintAssist.HintOpacity=".26"
                                     md:TextFieldAssist.HasClearButton="True"
                                     md:TextFieldAssist.LeadingIcon="Search"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     Text="{Binding Keyword}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Width="32"
                                        Height="32"
                                        Margin="0,5,5,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SearchCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                    <md:PackIcon Kind="Search" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        Margin="0,0,5,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ReloadCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                    <md:PackIcon Kind="Reload" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        Margin="0,0,5,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding AddCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                    <md:PackIcon Kind="Add" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        Margin="0,0,5,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SaveAllCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                    <md:PackIcon Kind="ContentSaveAll" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        Margin="0,0,5,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding EditCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                    <md:PackIcon Kind="Edit" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        Margin="0,0,15,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                    <md:PackIcon Kind="Delete" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <DataGrid Margin="10"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ID">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,5,0,0" Text="{Binding CategoryId}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,5,0,0" Text="{Binding CategoryName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Description">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,5,0,0" Text="{Binding Description}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource LightGrayColorBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Orientation="Vertical">
                    <Border Margin="0,0,0,20"
                            Padding="5"
                            Background="{StaticResource LightGrayColorBrush}"
                            CornerRadius="3,3,0,0">
                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="Category Details"
                                   TextAlignment="Center" />
                    </Border>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Rectangle Width="220"
                                       Height="220"
                                       RadiusX="110"
                                       RadiusY="110"
                                       Stroke="{StaticResource LightGrayColorBrush}">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Path=SelectedCategory.Picture}" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="10"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Width="17"
                                           Height="17"
                                           RadiusX="90"
                                           RadiusY="90"
                                           Stroke="{StaticResource LightGrayColorBrush}">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding Path=SelectedCategory.Icon17}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Grid.Column="1"
                                           Width="25"
                                           Height="25"
                                           RadiusX="90"
                                           RadiusY="90"
                                           Stroke="{StaticResource LightGrayColorBrush}">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding Path=SelectedCategory.Icon25}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <Border Height="1"
                                    Margin="20"
                                    BorderBrush="{StaticResource LightGrayColorBrush}"
                                    BorderThickness="1" />
                            <Grid Margin="10"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Margin="0,0,0,10"
                                           FontFamily="Cambria"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Text="ID" />
                                <TextBlock Grid.Row="1"
                                           FontFamily="Cambria"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           Text="{Binding Path=SelectedCategory.CategoryId}" />
                            </Grid>
                            <Grid Margin="10"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Margin="0,0,0,10"
                                           FontFamily="Cambria"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Text="Name" />
                                <TextBlock Grid.Row="1"
                                           FontFamily="Cambria"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           Text="{Binding Path=SelectedCategory.CategoryName}" />
                            </Grid>
                            <Grid Margin="10"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Margin="0,0,0,10"
                                           FontFamily="Cambria"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Text="Description" />
                                <TextBlock Grid.Row="1"
                                           FontFamily="Cambria"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           Text="{Binding Path=SelectedCategory.Description}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>