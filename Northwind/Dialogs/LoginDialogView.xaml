<UserControl x:Class="Northwind.Dialogs.LoginDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Dialogs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Northwind.ViewModels"
             xmlns:views="clr-namespace:Northwind.Views"
             Width="300"
             MinHeight="480"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginDialogViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{x:Null}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             mc:Ignorable="d">
    <md:Card Margin="2"
             md:ElevationAssist.Elevation="Dp2"
             BorderBrush="{StaticResource LightGrayColorBrush}"
             BorderThickness="2"
             UniformCornerRadius="6">
        <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="White">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <views:NorthwindLogoView />
                <Border Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding Path=IsLoading, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisiblityConverter}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="128"
                                     Height="128"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Value="0" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryColorBrush}"
                                   Text="Loading..." />
                    </Grid>
                </Border>
                <Grid Grid.Row="1"
                      Margin="20"
                      Visibility="{Binding Path=IsLoading, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisiblityConverterInverted}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" Margin="0,50,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ComboBox Grid.Row="0"
                                  md:ComboBoxAssist.ShowSelectedItem="True"
                                  md:HintAssist.Hint="Select an employee"
                                  md:HintAssist.HintOpacity=".26"
                                  DisplayMemberPath="FullNameWithPositionAndTitle"
                                  ItemsSource="{Binding Path=Employees}"
                                  SelectedValue="{Binding SelectedEmployee}"
                                  Style="{StaticResource MaterialDesignComboBox}" />
                        <TextBox Grid.Row="1"
                                 Margin="0,10"
                                 md:HintAssist.Hint="or enter e-Mail of an employee"
                                 md:HintAssist.HintOpacity=".26"
                                 md:TextFieldAssist.HasClearButton="True"
                                 FontSize="14"
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 Text="{Binding Path=Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox Grid.Row="2"
                                     md:HintAssist.Hint="Enter your password"
                                     md:HintAssist.HintOpacity=".26"
                                     md:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     md:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource MaterialDesignRevealPasswordBox}" />
                        <Button Grid.Row="3"
                                Height="42"
                                Margin="0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{Binding LoginCommand}"
                                Content="Login"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        <TextBlock Grid.Row="4"
                                   Margin="0,10"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   FontSize="12"
                                   FontWeight="Regular"
                                   Text="{Binding Path=Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource DarkRedColorBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Message}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Message}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

            </Grid>

        </Border>
    </md:Card>
</UserControl>


