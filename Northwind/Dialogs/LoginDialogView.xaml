<UserControl x:Class="Northwind.Dialogs.LoginDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Dialogs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:Northwind.Views"
             xmlns:vms="clr-namespace:Northwind.ViewModels"
             Width="320"
             MinHeight="600"
             d:DataContext="{d:DesignInstance Type=vms:LoginDialogViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{x:Null}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             mc:Ignorable="d">
    <md:Card Margin="2"
             md:ElevationAssist.Elevation="Dp2"
             BorderBrush="{StaticResource LightGrayColorBrush}"
             BorderThickness="2"
             UniformCornerRadius="6">
        <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="White">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ShowGridLines="{Binding Path=IsInDebugMode}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <views:NorthwindLogoView />
                <Border Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding Path=IsLoading, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisiblityConverter}}">
                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ShowGridLines="{Binding Path=IsInDebugMode}">
                        <ProgressBar Width="160"
                                     Height="160"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Value="0" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryColorBrush}"
                                   Text="Loading..." />
                    </Grid>
                </Border>
                <Grid Grid.Row="1"
                      Margin="20"
                      ShowGridLines="{Binding Path=IsInDebugMode}"
                      Visibility="{Binding Path=IsLoading, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisiblityConverterInverted}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" Margin="0,120,0,-10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox Grid.Row="0"
                                  md:ComboBoxAssist.ShowSelectedItem="True"
                                  md:HintAssist.Hint="Select an employee"
                                  md:HintAssist.HintOpacity=".26"
                                  ItemsSource="{Binding Path=Employees}"
                                  SelectedValue="{Binding SelectedEmployee}"
                                  Style="{StaticResource MaterialDesignComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ShowGridLines="{Binding Path=IsInDebugMode}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                BorderBrush="#F5F5F5"
                                                BorderThickness="4"
                                                CornerRadius="90">
                                            <Rectangle Width="24"
                                                       Height="24"
                                                       RadiusX="90"
                                                       RadiusY="90">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding Path=LastName, Converter={StaticResource NameToImageConverter}}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>
                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                            <TextBlock Foreground="{StaticResource PrimaryColorBrush}" Text="{Binding FullName}" />
                                            <TextBlock FontSize="10"
                                                       Foreground="{StaticResource DarkGrayColorBrush}"
                                                       Text="{Binding TitleOfCourtesyAndPosition}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Row="1"
                                 Margin="0,10"
                                 md:HintAssist.Hint="or enter e-Mail of an employee"
                                 md:HintAssist.HintOpacity=".26"
                                 md:TextFieldAssist.HasClearButton="True"
                                 FontSize="14"
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 Text="{Binding Path=Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox Grid.Row="2"
                                     md:HintAssist.Hint="Enter your password"
                                     md:HintAssist.HintOpacity=".26"
                                     md:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     md:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource MaterialDesignRevealPasswordBox}" />
                        <TextBlock Grid.Row="3"
                                   Margin="0,10"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   FontSize="12"
                                   FontWeight="Regular"
                                   Text="{Binding Path=Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource DarkRedColorBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Message}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Message}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Row="4"
                                Height="42"
                                Margin="0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Command="{Binding LoginCommand}"
                                Content="Login"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                    </Grid>
                </Grid>

            </Grid>

        </Border>
    </md:Card>
</UserControl>


