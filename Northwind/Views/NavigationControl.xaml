<UserControl x:Class="Northwind.Views.NavigationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="450"
             d:DesignWidth="800"
             DataContext="{Binding}"
             mc:Ignorable="d">
    <StackPanel>
        <!--  PROFILE  -->
        <StackPanel Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#EEEEEE"
                    BorderThickness="6"
                    CornerRadius="90">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      Opacity=".075"
                                      ShadowDepth="0" />
                </Border.Effect>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#F6F6F6"
                        BorderThickness="8"
                        CornerRadius="90">
                    <Rectangle Width="120"
                               Height="120"
                               RadiusX="90"
                               RadiusY="90">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding Path=CurrentUser.LastName, Converter={StaticResource NameToImageConverter}}" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
            </Border>
            <TextBlock Margin="0,10,0,0"
                       FontSize="14"
                       Foreground="{StaticResource PrimaryColorBrush}"
                       Text="{Binding Path=CurrentUser.FullName}"
                       TextAlignment="Center" />
            <TextBlock FontSize="10"
                       Foreground="{StaticResource PrimaryColorBrush}"
                       Text="{Binding Path=CurrentUser.TitleOfCourtesyAndPosition}"
                       TextAlignment="Center" />

        </StackPanel>
        <Border Grid.Row="1"
                Height="1"
                Margin="0,20,0,10"
                BorderBrush="{StaticResource PrimaryColorBrush}"
                BorderThickness="1" />
        <ItemsControl ItemsSource="{Binding NavigationService.Items}">
            <ItemsControl.Resources>
                <Style TargetType="md:PackIcon">
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="22" />
                </Style>
                <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                    <Setter Property="Margin" Value="0,5" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.Resources>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:NavigationItemControl DataContext="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="3"
                Height="1"
                Margin="0,10,0,20"
                BorderBrush="{StaticResource PrimaryColorBrush}"
                BorderThickness="1" />
        <StackPanel Grid.Row="4"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom" />
    </StackPanel>
</UserControl>
