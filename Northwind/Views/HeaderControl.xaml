<UserControl x:Class="Northwind.Views.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Northwind.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="450"
             d:DesignWidth="800"
             DataContext="{Binding}"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseDoubleClick">
            <i:InvokeCommandAction Command="{Binding ResizeWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Grid.Row="0"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="10"
            Background="White"
            BorderBrush="{StaticResource LightGrayColorBrush}"
            BorderThickness="0,0,0,1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Opacity=".25"
                              ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  APPLICATION TITLE  -->
            <Button x:Name="ShowMenuButton"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    md:RippleAssist.IsDisabled="True"
                    Command="{Binding Path=ToggleMenuCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Visibility="{Binding Path=IsMenuOpen, Converter={StaticResource BoolToVisiblityConverterInverted}}">
                <md:PackIcon Width="22" Kind="Menu" />
            </Button>
            <Button x:Name="HideMenuButton"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    md:RippleAssist.IsDisabled="True"
                    Command="{Binding Path=ToggleMenuCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Visibility="{Binding Path=IsMenuOpen, Converter={StaticResource BoolToVisiblityConverter}}">
                <md:PackIcon Width="22" Kind="MenuOpen" />
            </Button>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Width="60"
                    Height="60"
                    Margin="120,0,0,-30"
                    Padding="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1200"
                    Background="White"
                    BorderBrush="{StaticResource MediumGrayColorBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="90">
                <Image Margin="5"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Source="/Resources/Nautic.png"
                       Stretch="UniformToFill" />
            </Border>
            <!--  OPERATION BUTTONS  -->
            <Grid Grid.Column="2"
                  Margin="10,1,0,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.Resources>
                    <Style TargetType="md:PackIcon">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="2"
                        Width="32"
                        Height="32"
                        Command="{Binding Path=ToggleThemeCommand}"
                        ToolTip="{Binding DarkThemeTooltip, Mode=OneWay}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.HasDropShadow="True"
                        ToolTipService.InitialShowDelay="0">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <md:PackIcon Width="22"
                                                 Height="22"
                                                 Kind="ThemeLightDark" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="4"
                        Width="32"
                        Height="32"
                        Command="{Binding Path=MinimizeWindowStateCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <md:PackIcon Width="22"
                                                 Height="22"
                                                 Kind="WindowMinimize" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="6"
                        Width="32"
                        Height="32"
                        Command="{Binding Path=MaximizeOrNormalizeWindowStateCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=WindowState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="Normal">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <md:PackIcon Width="22"
                                                         Height="22"
                                                         Kind="WindowMaximize" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=WindowState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="Maximized">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <md:PackIcon Width="22"
                                                         Height="22"
                                                         Kind="WindowRestore" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="8"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        Command="{Binding Path=ApplicationCloseCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <md:PackIcon Width="22"
                                                 Height="22"
                                                 Kind="WindowClose" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <md:PackIcon Width="22"
                                                         Height="22"
                                                         Foreground="{StaticResource MediumRedColorBrush}"
                                                         Kind="WindowClose" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!--  OVERALL PROGRESS BAR  -->
            <ProgressBar Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Height="3"
                         Margin="-10,0,-10,-7"
                         VerticalAlignment="Bottom"
                         Panel.ZIndex="-10"
                         IsIndeterminate="True"
                         Visibility="{Binding Path=IsBusy, Converter={StaticResource BoolToVisiblityConverter}}" />

        </Grid>
    </Border>
</UserControl>
