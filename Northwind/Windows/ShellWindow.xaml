<Window x:Class="Northwind.Windows.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Northwind.Core.Controls;assembly=Northwind.Core"
        xmlns:core="clr-namespace:Northwind.Core;assembly=Northwind.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:services="clr-namespace:Northwind.Services;assembly=Northwind.Services"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:views="clr-namespace:Northwind.Views"
        xmlns:vms="clr-namespace:Northwind.ViewModels"
        Title="{Binding Title}"
        Width="{Binding Path=Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Height="{Binding Path=Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        prism:ViewModelLocator.AutoWireViewModel="True"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="{Binding Path=ResizeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen"
        WindowState="{Binding Path=WindowState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        WindowStyle="None">
    <md:Card Margin="4"
             md:ElevationAssist.Elevation="Dp2"
             BorderBrush="{StaticResource LightGrayColorBrush}"
             BorderThickness="2"
             UniformCornerRadius="6">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!--  HEADER  -->
                <RowDefinition Height="Auto" />
                <!--  MENU / CONTENT  -->
                <RowDefinition Height="*" />
                <!--  FOOTER  -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  HEADER  -->
            <views:HeaderControl DataContext="{Binding}" />

            <!--  MENU / CONTENT  -->
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Panel.ZIndex="-1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  MENU  -->
                <Border x:Name="MenuBorder"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Width="{Binding MenuWidthDouble}"
                        MinWidth="0"
                        Margin="0"
                        BorderBrush="{StaticResource LightGrayColorBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid x:Name="MenuContent"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Opacity="1">
                        <views:NavigationControl HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 DataContext="{Binding}" />
                    </Grid>
                </Border>

                <!--  CONTENT  -->
                <Border Grid.Column="1"
                        Margin="20"
                        Padding="0"
                        Background="{DynamicResource MaterialDesignBackground}">
                    <StackPanel HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Vertical">
                        <TextBlock Margin="0,0,0,10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryColorBrush}"
                                   Text="{Binding Path=CurrentViewName, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                        <controls:FadingContentControl HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}"
                                                       FadeVisibility="True" />
                        <!--<ContentControl HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" />-->
                    </StackPanel>
                </Border>

            </Grid>

            <!--  FOOTER  -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="10"
                    Background="White"
                    BorderBrush="{StaticResource MediumGrayColorBrush}"
                    BorderThickness="0,1,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      Opacity=".25"
                                      ShadowDepth="1" />
                </Border.Effect>
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StatusBar Grid.Column="1"
                               Margin="0,10,10,10"
                               Background="Transparent">
                        <StatusBarItem Margin="10,0,0,0">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource PrimaryColorBrush}"
                                             Kind="Email" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="{Binding Path=CurrentUser.Email}" />
                            </Grid>
                        </StatusBarItem>
                        <StatusBarItem Margin="10,0,0,0">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource PrimaryColorBrush}"
                                             Kind="Phone" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="{Binding Path=CurrentUser.Phone}" />
                            </Grid>
                        </StatusBarItem>
                        <StatusBarItem Margin="10,0,0,0">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource PrimaryColorBrush}"
                                             Kind="AddressMarker" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="{Binding Path=CurrentUser.FullAddress}" />
                            </Grid>
                        </StatusBarItem>
                        <StatusBarItem Margin="10,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Text="{Binding Path=Height, StringFormat=N0}" />
                                    <TextBlock Text=" x " />
                                    <TextBlock HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Text="{Binding Path=Width, StringFormat=N0}" />
                                </StackPanel>
                            </Grid>
                        </StatusBarItem>
                    </StatusBar>
                    <Border Grid.Row="1"
                            Width="60"
                            Height="60"
                            Margin="80,-30,0,-30"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="-2"
                            Background="White"
                            BorderBrush="{StaticResource MediumGrayColorBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="90">
                        <Button Margin="0,0,0,0" Style="{StaticResource MaterialDesignIconButton}">
                            <md:PackIcon Width="24"
                                         Height="24"
                                         Kind="ExitToApp" />
                        </Button>
                    </Border>
                </Grid>

            </Border>
        </Grid>

    </md:Card>
</Window>
