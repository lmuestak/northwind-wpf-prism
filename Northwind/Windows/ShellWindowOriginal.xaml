<Window x:Class="Northwind.Windows.ShellWindowOriginal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Northwind;assembly=Northwind.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:services="clr-namespace:Northwind.Services;assembly=Northwind.Services"
        xmlns:vms="clr-namespace:Northwind.ViewModels"
        Title="{Binding Title}"
        Width="{Binding Path=Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Height="{Binding Path=Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        MinWidth="1280"
        MinHeight="768"
        prism:ViewModelLocator.AutoWireViewModel="True"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="{Binding Path=ResizeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen"
        WindowState="{Binding Path=WindowState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        WindowStyle="None">

    <md:Card Margin="2"
             md:ElevationAssist.Elevation="Dp2"
             BorderBrush="{StaticResource LightGrayColorBrush}"
             BorderThickness="2"
             UniformCornerRadius="6">

        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  HEADER  -->
            <Border Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="10"
                    Background="White"
                    BorderBrush="{StaticResource MediumGrayColorBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45"
                                      Opacity=".25"
                                      ShadowDepth="0" />
                </Border.Effect>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="225" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  APPLICATION TITLE  -->
                    <TextBlock Grid.Column="0"
                               Margin="10,5,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryColorBrush}"
                               Text="{Binding Title}" />
                    <!--  OPERATION BUTTONS  -->
                    <Grid Grid.Column="1"
                          Margin="10,1,0,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.Resources>
                            <Style TargetType="md:PackIcon">
                                <Setter Property="Width" Value="40" />
                                <Setter Property="Height" Value="40" />
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="2"
                                Command="{Binding Path=ToggleThemeCommand}"
                                ToolTip="{Binding DarkThemeTooltip, Mode=OneWay}"
                                ToolTipService.BetweenShowDelay="0"
                                ToolTipService.HasDropShadow="True"
                                ToolTipService.InitialShowDelay="0">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <md:PackIcon Width="16"
                                                         Height="16"
                                                         Kind="ThemeLightDark" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="4" Command="{Binding Path=MinimizeWindowStateCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <md:PackIcon Width="16"
                                                         Height="16"
                                                         Kind="WindowMinimize" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="6" Command="{Binding Path=MaximizeOrNormalizeWindowStateCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=WindowState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="Normal">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <md:PackIcon Width="16"
                                                                 Height="16"
                                                                 Kind="WindowMaximize" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=WindowState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="Maximized">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <md:PackIcon Width="16"
                                                                 Height="16"
                                                                 Kind="WindowRestore" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="8"
                                Margin="0,0,10,0"
                                Command="{Binding Path=ApplicationCloseCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <md:PackIcon Width="16"
                                                         Height="16"
                                                         Kind="WindowClose" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <md:PackIcon Width="16"
                                                                 Height="16"
                                                                 Foreground="{StaticResource MediumRedColorBrush}"
                                                                 Kind="WindowClose" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <!--  OVERALL PROGRESS BAR  -->
                    <ProgressBar Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Height="6"
                                 Margin="0,0,0,-6"
                                 VerticalAlignment="Bottom"
                                 Panel.ZIndex="-10"
                                 IsIndeterminate="True"
                                 Visibility="{Binding Path=IsBusy, Converter={StaticResource BoolToVisiblityConverter}}" />
                </Grid>
            </Border>
            <!--  MAIN AREA  -->
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Panel.ZIndex="9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  MENU  -->
                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="0"
                        Background="{StaticResource MaterialDesign.Brush.Background}"
                        BorderBrush="{StaticResource LightGrayColorBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,20,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="#F5F5F5"
                                    BorderThickness="4"
                                    CornerRadius="90">
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BorderBrush="#EEEEEE"
                                        BorderThickness="4"
                                        CornerRadius="90">
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="4"
                                            CornerRadius="90">
                                        <Rectangle Width="90"
                                                   Height="90"
                                                   RadiusX="90"
                                                   RadiusY="90"
                                                   ToolTip="{Binding Path=CurrentUser.Title}"
                                                   ToolTipService.BetweenShowDelay="0"
                                                   ToolTipService.HasDropShadow="True"
                                                   ToolTipService.InitialShowDelay="0">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding Path=CurrentUser.LastName, Converter={StaticResource NameToImageConverter}}" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Border>
                                </Border>
                            </Border>
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource PrimaryColorBrush}"
                                       Text="{Binding Path=CurrentUser.FullName}"
                                       TextAlignment="Center" />
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource PrimaryColorBrush}"
                                       Text="{Binding Path=CurrentUser.Email}"
                                       TextAlignment="Center" />

                        </StackPanel>
                        <Border Grid.Row="1"
                                Height="1"
                                Margin="10,20,0,0"
                                BorderBrush="{StaticResource PrimaryColorBrush}"
                                BorderThickness="1" />
                        <ItemsControl Grid.Row="2"
                                      Margin="10"
                                      ItemsSource="{Binding Path=NavigationService.Items}">
                            <ItemsControl.Resources>
                                <Style TargetType="md:PackIcon">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="Height" Value="20" />
                                </Style>
                                <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                                    <Setter Property="Width" Value="200" />
                                    <Setter Property="Margin" Value="0,4" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:NavigationItemViewModel}">
                                    <Button Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=DataContext.NavigateToCommand}" CommandParameter="{Binding Path=Target}">
                                        <DockPanel Margin="0,2"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   LastChildFill="True">
                                            <md:PackIcon HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Kind="{Binding Path=Icon}" />
                                            <TextBlock Margin="10,3,0,0"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center"
                                                       DockPanel.Dock="Right"
                                                       Text="{Binding Name}" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                        <Border Grid.Row="3"
                                Height="1"
                                Margin="10,0"
                                BorderBrush="{StaticResource PrimaryColorBrush}"
                                BorderThickness="1" />
                        <StackPanel Grid.Row="4"
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
                <!--  CONTENT  -->
                <Border Grid.Column="1"
                        Margin="20"
                        Padding="0"
                        Background="{DynamicResource MaterialDesignBackground}">
                    <ContentControl HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" />
                </Border>


            </Grid>
            <!--  FOOTER  -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="10"
                    Background="White"
                    BorderBrush="{StaticResource MediumGrayColorBrush}"
                    BorderThickness="0,1,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      Opacity=".25"
                                      ShadowDepth="1" />
                </Border.Effect>
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StatusBar Grid.Column="1"
                               Margin="0,10,10,10"
                               Background="Transparent">


                        <StatusBarItem Margin="10,0,0,0">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource PrimaryColorBrush}"
                                             Kind="Email" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="{Binding Path=CurrentUser.Email}" />
                            </Grid>
                        </StatusBarItem>
                        <StatusBarItem Margin="10,0,0,0">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource PrimaryColorBrush}"
                                             Kind="Phone" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="{Binding Path=CurrentUser.Phone}" />
                            </Grid>
                        </StatusBarItem>
                        <StatusBarItem Margin="10,0,0,0">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource PrimaryColorBrush}"
                                             Kind="AddressMarker" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="{Binding Path=CurrentUser.FullAddress}" />
                            </Grid>
                        </StatusBarItem>


                        <StatusBarItem Margin="10,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Text="{Binding Path=Height, StringFormat=N0}" />
                                    <TextBlock Text=" x " />
                                    <TextBlock HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Text="{Binding Path=Width, StringFormat=N0}" />
                                </StackPanel>
                            </Grid>
                        </StatusBarItem>
                    </StatusBar>
                    <Border Grid.Row="1"
                            Width="60"
                            Height="60"
                            Margin="80,-30,0,-30"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="-2"
                            Background="White"
                            BorderBrush="{StaticResource MediumGrayColorBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="90">
                        <Button Margin="0,0,0,0" Style="{StaticResource MaterialDesignIconButton}">
                            <md:PackIcon Width="24"
                                         Height="24"
                                         Kind="ExitToApp" />
                        </Button>
                    </Border>
                </Grid>

            </Border>
        </Grid>
    </md:Card>
</Window>
