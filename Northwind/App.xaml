<prism:PrismApplication x:Class="Northwind.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controls="clr-namespace:Northwind.Core.Controls;assembly=Northwind.Core"
                        xmlns:converters="clr-namespace:Northwind.Converters;assembly=Northwind.Core"
                        xmlns:local="clr-namespace:Northwind"
                        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                        xmlns:prism="http://prismlibrary.com/"
                        xmlns:services="clr-namespace:Northwind.Services;assembly=Northwind.Services"
                        xmlns:sys="clr-namespace:System;assembly=mscorlib"
                        xmlns:sys1="http://schemas.microsoft.com/netfx/2009/xaml/presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:CustomColorTheme BaseTheme="Light"
                                     PrimaryColor="#587397"
                                     SecondaryColor="#ffd0a4" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="PrimaryColor">#587397</Color>
            <Color x:Key="SecondaryColor">#ffd0a4</Color>

            <Color x:Key="LightTealColor">#78d7d7</Color>
            <Color x:Key="MediumTealColor">#00b4b5</Color>
            <Color x:Key="DarkTealColor">#0f8f8f</Color>

            <Color x:Key="LightRedColor">#f08691</Color>
            <Color x:Key="MediumRedColor">#e63144</Color>
            <Color x:Key="DarkRedColor">#c4293a</Color>

            <Color x:Key="LightGrayColor">#dedede</Color>
            <Color x:Key="MediumGrayColor">#b7b7b7</Color>
            <Color x:Key="DarkGrayColor">#898989</Color>

            <SolidColorBrush x:Key="PrimaryColorBrush" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="SecondaryColorBrush" Color="{StaticResource SecondaryColor}" />

            <SolidColorBrush x:Key="LightTealColorBrush" Color="{StaticResource LightTealColor}" />
            <SolidColorBrush x:Key="MediumTealColorBrush" Color="{StaticResource MediumTealColor}" />
            <SolidColorBrush x:Key="DarkTealColorBrush" Color="{StaticResource DarkTealColor}" />

            <SolidColorBrush x:Key="LightRedColorBrush" Color="{StaticResource LightRedColor}" />
            <SolidColorBrush x:Key="MediumRedColorBrush" Color="{StaticResource MediumRedColor}" />
            <SolidColorBrush x:Key="DarkRedColorBrush" Color="{StaticResource DarkRedColor}" />

            <SolidColorBrush x:Key="LightGrayColorBrush" Color="{StaticResource LightGrayColor}" />
            <SolidColorBrush x:Key="MediumGrayColorBrush" Color="{StaticResource MediumGrayColor}" />
            <SolidColorBrush x:Key="DarkGrayColorBrush" Color="{StaticResource DarkGrayColor}" />

            <Style x:Key="TopShadow" TargetType="Rectangle">
                <Setter Property="Height" Value="8" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#40000040" />
                            <GradientStop Offset=".25" Color="#10000020" />
                            <GradientStop Offset=".5" Color="#00000000" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BottomShadow" TargetType="Rectangle">
                <Setter Property="Height" Value="8" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#40000040" />
                            <GradientStop Offset=".25" Color="#10000020" />
                            <GradientStop Offset=".5" Color="#00000000" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BottomLongShadow" TargetType="Rectangle">
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#40000040" />
                            <GradientStop Offset=".25" Color="#10000020" />
                            <GradientStop Offset=".5" Color="#00000000" />
                            <GradientStop Offset=".75" Color="#00000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LeftShadow" TargetType="Rectangle">
                <Setter Property="Width" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#40000040" />
                            <GradientStop Offset=".25" Color="#10000020" />
                            <GradientStop Offset=".5" Color="#00000000" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RightShadow" TargetType="Rectangle">
                <Setter Property="Width" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Offset="1" Color="#40000040" />
                            <GradientStop Offset=".75" Color="#10000020" />
                            <GradientStop Offset=".5" Color="#00000000" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RightLongShadow" TargetType="Rectangle">
                <Setter Property="Width" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Offset="1" Color="#40000040" />
                            <GradientStop Offset=".75" Color="#10000020" />
                            <GradientStop Offset=".5" Color="#00000000" />
                            <GradientStop Offset=".25" Color="#00000000" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <md:BooleanToVisibilityConverter x:Key="BoolToVisiblityConverter"
                                             FalseValue="Collapsed"
                                             TrueValue="Visible" />
            <md:BooleanToVisibilityConverter x:Key="BoolToVisiblityConverterInverted"
                                             FalseValue="Visible"
                                             TrueValue="Collapsed" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />

            <converters:NameToImageConverter x:Key="NameToImageConverter" />

            <sys:Double x:Key="MenuExpandedWidth">220</sys:Double>
            <Duration x:Key="AnimDuration">0:0:0.25</Duration>

            <CubicEase x:Key="Ease" EasingMode="EaseOut" />

            <!--  Expand / collapse storyboards target the Sidebar.Width  -->
            <Storyboard x:Key="ExpandMenu">
                <DoubleAnimation EasingFunction="{StaticResource Ease}"
                                 Storyboard.TargetName="Sidebar"
                                 Storyboard.TargetProperty="Width"
                                 To="{StaticResource MenuExpandedWidth}"
                                 Duration="{StaticResource AnimDuration}" />
                <!--  Optional: fade in menu contents slightly  -->
                <DoubleAnimation Storyboard.TargetName="SidebarContent"
                                 Storyboard.TargetProperty="Opacity"
                                 To="1"
                                 Duration="{StaticResource AnimDuration}" />
            </Storyboard>

            <Storyboard x:Key="CollapseMenu">
                <DoubleAnimation EasingFunction="{StaticResource Ease}"
                                 Storyboard.TargetName="Sidebar"
                                 Storyboard.TargetProperty="Width"
                                 To="0"
                                 Duration="{StaticResource AnimDuration}" />
                <!--  Optional: fade out to avoid harsh cut as width shrinks  -->
                <DoubleAnimation Storyboard.TargetName="SidebarContent"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0"
                                 Duration="0:0:0.15" />
            </Storyboard>

            <Storyboard x:Key="OpenMenu">
                <DoubleAnimation EasingFunction="{StaticResource Ease}"
                                 Storyboard.TargetName="MenuBorder"
                                 Storyboard.TargetProperty="Width"
                                 To="{StaticResource MenuExpandedWidth}"
                                 Duration="{StaticResource AnimDuration}" />
                <!--  Optional: fade in menu contents slightly  -->
                <DoubleAnimation Storyboard.TargetName="MenuContent"
                                 Storyboard.TargetProperty="Opacity"
                                 To="1"
                                 Duration="{StaticResource AnimDuration}" />
            </Storyboard>

            <Storyboard x:Key="CloseMenu">
                <DoubleAnimation EasingFunction="{StaticResource Ease}"
                                 Storyboard.TargetName="MenuBorder"
                                 Storyboard.TargetProperty="Width"
                                 To="0"
                                 Duration="{StaticResource AnimDuration}" />
                <!--  Optional: fade out to avoid harsh cut as width shrinks  -->
                <DoubleAnimation Storyboard.TargetName="MenuContent"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0"
                                 Duration="0:0:0.15" />
            </Storyboard>

            <Storyboard x:Key="fadeIn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="00:00:01" Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="150" />
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="fadeOut">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="300" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="fadeInVertical">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.7" Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="100" />
                    <EasingDoubleKeyFrame KeyTime="00:00:00.7" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="fadeOutVertical">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="200" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Style TargetType="controls:FadingContentControl">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:FadingContentControl">
                            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter x:Name="mainArea"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Cursor="{TemplateBinding Cursor}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                                <Rectangle x:Name="paintArea">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="controls:ScrollingContentControl">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:ScrollingContentControl">
                            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                <Label Content="{TemplateBinding Content}"
                                       FontFamily="Tahoma"
                                       FontSize="20" />

                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Storyboard x:Key="scrollIn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="00:00:01.5" Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="600" />
                    <EasingDoubleKeyFrame KeyTime="00:00:01.5" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="scrollOut">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="00:00:01.5" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="00:00:01.5" Value="-600" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="ElementFadeIn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="00:00:01" Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.RenderTransform).(TranslateTransform.Y)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="100" />
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
