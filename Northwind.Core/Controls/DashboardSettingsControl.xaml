<UserControl x:Class="Northwind.Core.Controls.DashboardSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Northwind.Core.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <StackPanel Background="White">
        <TextBlock Margin="15,10,0,0"
                   FontWeight="Bold"
                   Foreground="Black"
                   Text="{Binding Title}" />

        <TextBlock Margin="20,15,0,0"
                   Foreground="Black"
                   Text="Dashboard Name" />

        <TextBox Margin="20,0,20,0"
                 Tag="Dashboard Name"
                 Text="{Binding DashboardName, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Margin="0,20,20,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0"
                    Command="{Binding CommandSaveDashboardName}"
                    ToolTipService.ShowOnDisabled="True">

                <TextBlock Margin="15,5,15,5"
                           Foreground="White"
                           Text="Save" />
            </Button>

            <Button Margin="10,0,0,0" Command="{Binding CommandCancelDashboardConfiguration}">
                <TextBlock Margin="15,5,15,5"
                           Foreground="White"
                           Text="Cancel" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
